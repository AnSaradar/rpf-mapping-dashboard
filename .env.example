# Copy to .env for local Docker builds (Vite bakes these into the bundle).

VITE_MAPBOX_TOKEN=
VITE_API_BASE_URL=

# OpenRouter (chatbot LLM) — baked into the client bundle at build time
VITE_OPENAI_API_KEY=
VITE_OPENAI_API_URL=https://openrouter.ai/api/v1
VITE_OPENAI_MODEL=openai/gpt-4o-mini

# Set to true to skip login and open protected routes (local dev only)
VITE_DISABLE_AUTH=false

# Host port for docker compose (default 8080)
HOST_PORT=8080
